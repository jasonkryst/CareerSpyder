# Shell scripts run inside Linux containers -- force LF regardless of the
# checking-out platform's core.autocrlf, so a Windows checkout can't silently
# break the shebang (Docker's `#!/bin/sh` won't tolerate a CRLF line ending).
*.sh text eol=lf

# Bundled third-party wordlist: keep byte-identical to upstream so its
# SHA-256 (pinned in docs/third-party-notices.md and a test) holds on every OS.
app/security/wordlists/*.txt -text
