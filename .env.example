# Copy to .env and fill in your values: cp .env.example .env
# .env is gitignored -- never commit real credentials.

# PostgreSQL connection string. The postgres container reads POSTGRES_PASSWORD
# to set the database password; DATABASE_URL must use the same value.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://careerspyder:change-me@postgres:5432/careerspyder

# Initial admin account. Only used the very first time the database is empty;
# ignored after the admin user exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# REQUIRED. Signs session cookies and password-reset links. The app refuses to
# start if this is empty, a placeholder, or shorter than 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required to send email digests.
SMTP_PASSWORD=your-smtp-password

# First-boot defaults only -- these seed the settings table the first time
# the database is empty. After that, /settings is the source of truth and
# these are ignored.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com

# Cron expression (5 fields: min hour dom month dow) for when the daily scrape runs.
# Default: every day at 07:00 in TZ. See https://crontab.guru for reference.
RUN_CRON=0 7 * * *

# Timezone the scheduler and RUN_CRON are interpreted in.
TZ=America/Chicago

# REQUIRED for password-reset emails (and used to build invite links and the
# digest's "View all jobs" link). Set it to the site's canonical URL.
# If this is https://, the session cookie is marked Secure -- sign in through
# this URL, not plain http://<host>:32600, or login will appear to do nothing.
PUBLIC_BASE_URL=https://jobs.example.com

# Optional: a GA4 Measurement ID (format G-XXXXXXXXXX) to enable Google
# Analytics page-view tracking. Leave unset to disable it entirely -- no
# gtag.js script is loaded and the CSP stays locked down to just this site.
GA_MEASUREMENT_ID=
